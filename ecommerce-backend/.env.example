# Spring Boot reads these from the process environment. Copy this file to .env
# for local reference, then export the variables before starting the application.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=your_mail_app_password
SMARTCART_MAIL_FROM=you@example.com
